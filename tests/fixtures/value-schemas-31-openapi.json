{
  "openapi": "3.1.0",
  "info": {
    "title": "Gadget API",
    "description": "OpenAPI 3.1 spec with an inline request body carrying its own $defs",
    "version": "1.0.0"
  },
  "paths": {
    "/gadgets": {
      "post": {
        "operationId": "createGadget",
        "summary": "Create a gadget",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["kind"],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": ["basic", "fancy"]
                  },
                  "shared": {
                    "$ref": "#/components/schemas/SharedThing"
                  }
                },
                "$defs": {
                  "Meta": {
                    "$ref": "#/components/schemas/SharedThing"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Gadget created"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SharedThing": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string"
          }
        }
      }
    }
  }
}
