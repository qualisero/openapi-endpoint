{
  "openapi": "3.0.3",
  "info": {
    "title": "Direction Test API",
    "description": "Fixture spec for testing response-reachable Responses namespace and Source JSDoc",
    "version": "1.0.0"
  },
  "paths": {
    "/pets": {
      "get": {
        "operationId": "listPets",
        "summary": "List pets",
        "responses": {
          "200": {
            "description": "A list of pets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PetDetail"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createPet",
        "summary": "Create a pet",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PetCreateArgs"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created pet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PetDetail"
                }
              }
            }
          }
        }
      }
    },
    "/categories/{categoryId}": {
      "get": {
        "operationId": "getCategory",
        "summary": "Get a category",
        "parameters": [
          {
            "name": "categoryId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "A category",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Category"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "updateCategory",
        "summary": "Update a category",
        "parameters": [
          {
            "name": "categoryId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Category"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated category",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Category"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Species": {
        "type": "string",
        "enum": ["cat", "dog", "bird"]
      },
      "Category": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "readOnly": true },
          "name": { "type": "string" }
        }
      },
      "PetDetail": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "readOnly": true },
          "name": { "type": "string" },
          "species": { "$ref": "#/components/schemas/Species" }
        }
      },
      "PetCreateArgs": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "species": { "$ref": "#/components/schemas/Species" }
        }
      }
    }
  }
}
