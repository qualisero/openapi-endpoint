{
  "openapi": "3.0.3",
  "info": {
    "title": "Skip API",
    "description": "Spec whose operations have no extractable inline application/json schema",
    "version": "1.0.0"
  },
  "paths": {
    "/refbody": {
      "post": {
        "operationId": "createWithRefBody",
        "summary": "Request body is a $ref to components.requestBodies",
        "requestBody": {
          "$ref": "#/components/requestBodies/CreateBody"
        },
        "responses": {
          "201": {
            "description": "Created (no content)"
          }
        }
      }
    },
    "/charset": {
      "post": {
        "operationId": "createWithCharset",
        "summary": "JSON media type with charset parameter",
        "requestBody": {
          "content": {
            "application/json; charset=utf-8": {
              "schema": {
                "$ref": "#/components/schemas/Thing"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/Thing"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "requestBodies": {
      "CreateBody": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Thing"
            }
          }
        }
      }
    },
    "schemas": {
      "Thing": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        }
      }
    }
  }
}
